{
  "name": "flight-shade",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "build:pages": "vite build --mode pages",
    "preview": "vite preview --host 0.0.0.0",
    "preview:pages": "vite preview --mode pages --host 0.0.0.0",
    "deploy": "npm run build:pages && gh-pages -d dist --nojekyll",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@lucide/vue": "^1.61.0",
    "leaflet": "^1.9.4",
    "suncalc": "1.9.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "sass": "^1.93.0",
    "vite": "^7.1.0"
  }
}
